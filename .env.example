# AgentOS Gateway — optional environment overrides
#
# Nothing here is required. The gateway generates its own admin token on first
# boot and writes it to data/.env (mode 0600), which is gitignored — provider API
# keys live there too, added through the dashboard rather than by hand.
#
# Copy to data/.env only if you need to override a default.

# Listen port. Default 9000.
#PORT=9000

# Bind address. Default 127.0.0.1 (loopback only).
# Set this to expose the gateway on your LAN — read docs/security.md first: /v1
# has no client authentication, so loopback binding is what keeps it private.
#HOST=127.0.0.1

# Dashboard password (HTTP Basic; the username is ignored). Generated on first
# boot if unset — you normally never set this yourself. It is shown on
# /admin/guide and printed in the startup banner.
#AGENTOS_ADMIN_TOKEN=

# Where config and logs are stored. Default ./data. Useful for running a second
# instance against a copied config without touching the real one.
#AGENTOS_DATA_DIR=./data

# Abort an upstream request if response headers take longer than this (ms).
# Unset by default: there is deliberately NO upstream timeout, because a slow
# provider on a long tool turn is not the same thing as a hung one.
#AGENTOS_UPSTREAM_TIMEOUT_MS=

# Per-connection-attempt timeout (ms) for dual-stack hosts. Raised from Node's
# 250 ms default because that default was producing spurious "connection timed
# out" errors against a healthy provider.
#AGENTOS_CONNECT_ATTEMPT_TIMEOUT_MS=2000
